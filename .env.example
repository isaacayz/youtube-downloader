# Runtime environment
APP_ENV=production
APP_PORT=8000

# Database credentials & connection
POSTGRES_PASSWORD=mediaapp_change_me_secret_pass
DATABASE_URL=postgresql+psycopg2://mediaapp:mediaapp_change_me_secret_pass@postgres:5432/mediaapp

# Redis connection
REDIS_URL=redis://redis:6379/0

# Storage paths (container internal paths)
MEDIA_ROOT=/downloads
STAGING_DIR=/staging

# Resource & job constraints
MAX_CONCURRENT_JOBS=1
MAX_UPLOAD_BYTES=2147483648
MAX_OUTPUT_BYTES=5368709120
MAX_JOB_DURATION_SECONDS=3600
MAX_REDIRECTS=3
JOB_RETRY_MAX=3
OUTPUT_RETENTION_DAYS=7
EVENT_RETENTION_DAYS=30

# Logging & Network
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
ENABLE_LAN_ACCESS=false

# Source policies
ENABLE_YOUTUBE_DOWNLOAD=false
